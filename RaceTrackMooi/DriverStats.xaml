<Window x:Class="RaceTrackMooi.DriverStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaceTrackMooi"
        mc:Ignorable="d"
        Title="DriverStats" Height="450" Width="800">
    <Window.DataContext>
        <local:DataContext/>
    </Window.DataContext>
    <Grid Background="DarkGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Fill="Gray" Grid.ColumnSpan="3" Grid.RowSpan="3"/>

        <Label Grid.Column="0" Grid.Row="0" Content="{Binding TrackName}"/>
        <Label Grid.Column="0" Grid.Row="1" Content="Laptimes" HorizontalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="1" Content="Points" HorizontalAlignment="Center"/>
        <Label Grid.Column="2" Grid.Row="1" Content="Result" HorizontalAlignment="Center"/>
        
        <ListView Width="250" Height="180" ItemsSource="{Binding Laptimes}" Grid.Row="2" VerticalAlignment="Top" Background="LightGray"></ListView>
        <ListView Width="250" Height="180" ItemsSource="{Binding Points}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Background="LightGray"></ListView>
        <ListView Width="250" Height="180" ItemsSource="{Binding Podium}" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Background="LightGray"></ListView>

    </Grid>
</Window>
