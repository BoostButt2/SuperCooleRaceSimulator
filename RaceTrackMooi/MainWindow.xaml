<Window x:Class="RaceTrackMooi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaceTrackMooi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:DataContext/>
    </Window.DataContext>

    <Grid Background="Gray" >


        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Grid.Row="0">
            <Menu DockPanel.Dock="Top" Height="20" VerticalAlignment="Top" Background="DarkGray">
                <MenuItem Background="Transparent" BorderBrush="Transparent" Header="Menu">
                    <MenuItem Header="Race stats" Click="MenuItem_RaceStats_Click"/>
                    <MenuItem Header="Driver stats" Click="MenuItem_DriverStats_Click"/>
                    <MenuItem Header="Close" Click="MenuItem_Exit_Click"/>
                </MenuItem>

            </Menu>
        </DockPanel>
        <Label Name="TrackName" VerticalAlignment="Top" Content="{Binding TrackName}" Grid.Row="1" Grid.ColumnSpan="2"/>
        <Image Name="EmptyImage" Grid.ColumnSpan="2" VerticalAlignment="Top" Stretch="Fill" Grid.Row="2"/>

    </Grid>
</Window>
